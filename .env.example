# Supabase Credentials (optional / as needed)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Development builds only; also requires a dedicated development database seed.
EXPO_PUBLIC_RIDE_SIMULATION=false

# Google Maps keys are client-visible; restrict each key in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
